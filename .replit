modules = ["nodejs-20"]
[nix]
channel = "stable-24_05"

[workflows]
runButton = "Run Server & Auto-Push"

[[workflows.workflow]]
name = "Run Server & Auto-Push"
author = 22930014
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start-auto-push.sh && npm install && npm start"

[[workflows.workflow]]
name = "Start Auto-Push"
author = 22930014
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start-auto-push.sh"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 37265
externalPort = 3000
